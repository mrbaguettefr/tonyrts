{
  "name": "iron-orbit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "node tests/browser.mjs",
    "dev:client": "vite --host 0.0.0.0",
    "server": "node --import tsx server/main.ts",
    "start": "node --import tsx server/main.ts",
    "test:multiplayer": "node --import tsx tests/multiplayer-browser.mjs"
  },
  "dependencies": {
    "three": "^0.180.0",
    "ws": "^8.21.3",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
